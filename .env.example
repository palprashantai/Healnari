# Copy this file to .env.
# The frontend talks only to the vision NestJS API (never to Supabase directly).
# Leave unset in dev — vite.config.js proxies /api to the local vision server.
# Set this for a prod build pointing at a deployed API.
# VITE_API_URL=https://your-api-host/api

# Web Push (VAPID) — must match the backend's VAPID_PUBLIC_KEY (vision/.env).
# Generate a pair with `npx web-push generate-vapid-keys` inside vision/.
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
