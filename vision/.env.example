# Copy this file to .env and fill in your Supabase project's values.

PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional — error monitoring (sentry.io). Without this, unhandled server
# errors are still logged to stdout but nothing pages anyone in production.
SENTRY_DSN=

# Set explicitly on every real deploy (Render/etc). Without this, Swagger
# docs stay reachable at /api/docs in prod and other prod-only guards won't
# engage (AUDIT_REPORT.md SEC-2, OPS-6). Local dev without this set still
# behaves like dev (Swagger visible); leave unset locally, or set to
# "development" for verbose error stack traces in API responses.
NODE_ENV=production

# Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Use the pooler, not the direct :5432 host — Nest opens many short-lived connections.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# service_role key — full DB/Auth admin access. Server-side only, never sent to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# NOT currently used by the backend — auth verification goes through
# SupabaseAuthGuard calling Supabase's own getUser() API, not local JWT
# verification (AUDIT_REPORT.md OPS-7). Kept here only in case that changes.
SUPABASE_JWT_SECRET=YOUR-JWT-SECRET

# Optional — TURN relay for WebRTC video calls (telemedicine). Without this,
# calls still work via STUN alone on most networks; TURN is only needed as a
# fallback for peers behind restrictive/symmetric NATs. Get a free key at
# metered.ca -> create a "TURN Server" app -> Dashboard shows both values below.
METERED_TURN_DOMAIN=healnari.metered.live
METERED_TURN_API_KEY=rRH1FTCLJpGxrKdqCyMej3Wla0RIWh7aQVHGx96_s2EFWbVi

# Web Push (VAPID) — powers incoming-call/notification delivery when the
# app tab is closed or backgrounded. Generate a pair with
# `npx web-push generate-vapid-keys` (run inside vision/ once web-push is
# installed). VAPID_PUBLIC_KEY must match the frontend's VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:support@healnari.com

# Optional — SMTP for real email delivery (new-account credentials, etc).
# Without these, EmailService logs a warning and skips sending instead of
# failing the request — e.g. a Gmail account with an App Password, or any
# SMTP provider (Resend, SES, Mailgun...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR-SMTP-USERNAME
SMTP_PASS=YOUR-SMTP-PASSWORD
EMAIL_FROM=HealNari <no-reply@healnari.app>

# Cashfree Payment Gateway — get App ID + Secret Key from the Cashfree
# merchant dashboard (Developers -> API Keys). Use the sandbox keys first;
# CASHFREE_ENV controls which Cashfree host we call (sandbox vs production).
# Without these, payment order creation fails with a clear 503 instead of
# silently pretending a payment succeeded.
CASHFREE_APP_ID=YOUR-CASHFREE-APP-ID
CASHFREE_SECRET_KEY=YOUR-CASHFREE-SECRET-KEY
CASHFREE_ENV=sandbox

# Must be a publicly reachable URL pointing at this backend (e.g. an ngrok
# tunnel in local dev, your real domain in production) — Cashfree calls
# {API_PUBLIC_URL}/api/billing/webhook/cashfree to notify us of payment
# completion. Without a real webhook, payments still settle correctly via the
# frontend's post-checkout status poll, just without the async confirmation.
API_PUBLIC_URL=https://your-backend-domain.example.com

# Optional — pin Cashfree's API version. Defaults to 2023-08-01 in code if unset.
CASHFREE_API_VERSION=2023-08-01

# AI chat (ai.service.ts) — only one of these needs to be set depending on
# which provider is wired up; the app degrades gracefully without either
# (AI features return a "not configured" response instead of failing).
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
OPENAI_API_KEY=YOUR-OPENAI-API-KEY
