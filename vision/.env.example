# Copy this file to .env and fill in your Supabase project's values.

PORT=5000
FRONTEND_URL=http://localhost:5173

# Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Use the pooler, not the direct :5432 host — Nest opens many short-lived connections.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# service_role key — full DB/Auth admin access. Server-side only, never sent to the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=YOUR-JWT-SECRET

# Optional — TURN relay for WebRTC video calls (telemedicine). Without this,
# calls still work via STUN alone on most networks; TURN is only needed as a
# fallback for peers behind restrictive/symmetric NATs. Get a free key at
# metered.ca -> create a "TURN Server" app -> Dashboard shows both values below.
METERED_TURN_DOMAIN=healnari.metered.live
METERED_TURN_API_KEY=rRH1FTCLJpGxrKdqCyMej3Wla0RIWh7aQVHGx96_s2EFWbVi

# Web Push (VAPID) — powers incoming-call/notification delivery when the
# app tab is closed or backgrounded. Generate a pair with
# `npx web-push generate-vapid-keys` (run inside vision/ once web-push is
# installed). VAPID_PUBLIC_KEY must match the frontend's VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:support@healnari.com

# Optional — SMTP for real email delivery (new-account credentials, etc).
# Without these, EmailService logs a warning and skips sending instead of
# failing the request — e.g. a Gmail account with an App Password, or any
# SMTP provider (Resend, SES, Mailgun...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR-SMTP-USERNAME
SMTP_PASS=YOUR-SMTP-PASSWORD
EMAIL_FROM=HealNari <no-reply@healnari.app>
